  // Method to send different types of messages
  // In GroupChatPage - corrected file upload method
void _sendFileMessage(File file, String messageType) async {
  final chatProvider = Provider.of<ChatProvider>(context, listen: false);
  final userProvider = Provider.of<UserProvider>(context, listen: false);

  // Show uploading indicator
  final tempMessage = ChatMessage(
    id: DateTime.now().millisecondsSinceEpoch,
    groupId: widget.group.id,
    userId: userProvider.user?.id ?? 0,
    message: 'Uploading file...',
    createdAt: DateTime.now().toIso8601String(),
    senderName: 'You',
    hasFile: true,
    hasMessage: false,
    fileName: file.path.split('/').last,
  );

  chatProvider.addMessage(tempMessage);
  _scrollToBottom();

  try {
    // Upload file using base64 approach (no header issues)
    final uploadResponse = await ChatService.uploadFile(file);
    
    if (uploadResponse.isSuccess && uploadResponse.data != null) {
      // File uploaded successfully, send message with file URL
      final fileUrl = uploadResponse.data!;
      final fileSize = await file.length() / (1024 * 1024); // Size in MB
      final fileName = file.path.split('/').last;
      final fileType = ChatService._getMimeType(fileName);
      
      // ✅ FIX: Use the correct parameters
      final success = await chatProvider.sendMessage(
        groupId: widget.group.id,
        message: 'Sent a file', // Customize based on file type
        userId: userProvider.user?.id ?? 0,
        messageType: 'file', // This tells the API it's a file message
        fileUrl: fileUrl,     // The uploaded file URL
        fileType: fileType,   // MIME type like 'image/jpeg'
        fileName: fileName,   // Original file name
        fileSize: fileSize,   // File size in MB
      );

      if (!success && mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text('Failed to send file'),
            backgroundColor: Colors.red,
          ),
        );
      }
    } else {
      // Upload failed
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text('Failed to upload file: ${uploadResponse.message}'),
            backgroundColor: Colors.red,
          ),
        );
      }
    }
  } catch (e) {
    if (mounted) {
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text('File upload error: $e'),
          backgroundColor: Colors.red,
        ),
      );
    }
  }
}

 // In GroupChatPage - add file message support to message bubbles
Widget _buildMessageBubble({
  required ChatMessage chatMessage,
  required bool isMe,
}) {
  // Handle file messages
  if (chatMessage.hasFile) {
    return _buildFileBubble(chatMessage, isMe);
  }
  
  // Handle call messages
  if (chatMessage.hasCall) {
    return _buildCallBubble(chatMessage, isMe);
  }
  
  // Handle text messages (existing code)
  return Row(
    mainAxisAlignment: isMe ? MainAxisAlignment.end : MainAxisAlignment.start,
    crossAxisAlignment: CrossAxisAlignment.start,
    children: [
      if (!isMe && chatMessage.senderAvatar.isNotEmpty)
        CircleAvatar(
          radius: 15,
          backgroundImage: NetworkImage(chatMessage.senderAvatar),
        )
      else if (!isMe)
        CircleAvatar(
          radius: 15,
          backgroundColor: AppColors.primaryOrange.withOpacity(0.1),
          child: Text(
            chatMessage.senderName.isNotEmpty 
                ? chatMessage.senderName[0].toUpperCase()
                : '?',
            style: TextStyle(
              color: AppColors.primaryOrange,
              fontWeight: FontWeight.bold,
              fontSize: 12,
            ),
          ),
        ),
      if (!isMe) SizedBox(width: 8),

      Flexible(
        child: Container(
          padding: EdgeInsets.all(12),
          margin: EdgeInsets.symmetric(vertical: 4),
          decoration: BoxDecoration(
            color: isMe
                ? AppColors.primaryOrangeLight
                : AppColors.primaryGreyLight,
            borderRadius: BorderRadius.only(
              topLeft: Radius.circular(16),
              topRight: Radius.circular(16),
              bottomLeft: isMe ? Radius.circular(16) : Radius.circular(4),
              bottomRight: isMe ? Radius.circular(4) : Radius.circular(16),
            ),
          ),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              if (!isMe && chatMessage.senderName != 'You')
                Text(
                  chatMessage.senderName,
                  style: TextStyle(
                    fontWeight: FontWeight.bold, 
                    fontSize: 10,
                    color: AppColors.primaryBlack,
                  ),
                ),
              SizedBox(height: 4),
              Text(
                chatMessage.message ?? '',
                style: TextStyle(fontSize: 12, color: AppColors.primaryBlack),
              ),
              SizedBox(height: 4),
              Text(
                _formatTime(chatMessage.createdAt),
                style: TextStyle(
                  fontSize: 8,
                  color: AppColors.primaryBlack.withOpacity(0.5),
                ),
              ),
            ],
          ),
        ),
      ),

      if (isMe) SizedBox(width: 8),
    ],
  );
}

